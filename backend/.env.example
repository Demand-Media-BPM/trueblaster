# Local backend setup example. Active settings belong in backend/.env.
# For real local campaign links, replace localhost PUBLIC_API_URL with your ngrok HTTPS origin.
# Backend only. Never put provider keys or database credentials in React/Netlify build variables.
MONGO_URI=mongodb://127.0.0.1:27018/trueblaster_local?replicaSet=trueblaster-local&directConnection=true
LOCAL_TEST_DATABASE_NAME=trueblaster_local
# Explicit opt-in only when intentionally sharing production data in development.
ALLOW_PRODUCTION_DATABASE_LOCAL=false
AUTH_SECRET=
TRACKING_SECRET=
IPINFO_TOKEN=
IPINFO_CACHE_TTL_SECONDS=3600
TRACKING_METADATA_RETENTION_DAYS=30
PORT=5000
NODE_ENV=development
PUBLIC_API_URL=http://localhost:5000
ENABLE_CAMPAIGN_WORKER=false

SENDGRID_API_KEY=
SENDGRID_PROJECT_ID=trueblaster-local
SENDGRID_WEBHOOK_PUBLIC_KEY=
SENDGRID_WEBHOOK_PREVIOUS_PUBLIC_KEY=
FROM_EMAIL=Peter.P@demandmediaglobal.com
FROM_NAME=Peter Parker
REPLY_TO_EMAIL=Peter.P@demandmediaglobal.com
SENDGRID_ALLOWED_SENDERS=Peter.P@demandmediaglobal.com
SENDGRID_UNSUBSCRIBE_GROUP_ID=
# Optional central fallback; these are NOT campaign form fields. Name is optional.
# Supply a real approved sender address, or approve an address already present in the template.
COMPANY_NAME=
COMPANY_POSTAL_ADDRESS=
COMPLIANCE_APPROVED_POSTAL_ADDRESSES=[]
COMPLIANCE_APPROVED_UNSUBSCRIBE_URLS=[]

# Optional delivery pacing. SendGrid's API also enforces account-specific limits.
CAMPAIGN_BATCH_SIZE=4
CAMPAIGN_CONCURRENCY=2
CAMPAIGN_BATCH_DELAY_MS=30000
